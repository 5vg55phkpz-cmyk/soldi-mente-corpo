const STORAGE_KEY = 'smc-auth-token';
let authMode = 'login';
let dashboardState = null;

const authScreen = document.getElementById('authScreen');
const appShell = document.getElementById('appShell');
const authForm = document.getElementById('authForm');
const authMessage = document.getElementById('authMessage');
const userLabel = document.getElementById('userLabel');

function setToken(token) {
  localStorage.setItem(STORAGE_KEY, token);
}

function getToken() {
  return localStorage.getItem(STORAGE_KEY);
}

function clearToken() {
  localStorage.removeItem(STORAGE_KEY);
}

function showMessage(message, isError = false) {
  authMessage.textContent = message;
  authMessage.style.color = isError ? '#fb7185' : '#34d399';
}

function setAuthMode(mode) {
  authMode = mode;
  document.querySelectorAll('.mode-btn').forEach((btn) => {
    btn.classList.toggle('active', btn.dataset.mode === mode);
  });
  const isRegister = mode === 'register';
  document.querySelector('#authForm button[type="submit"]').textContent = isRegister ? 'Registrati' : 'Entra';
}

async function request(url, options = {}, requireAuth = true) {
  const headers = {
    ...(options.headers || {}),
    'Content-Type': 'application/json'
  };

  if (requireAuth) {
    const token = getToken();
    if (!token) throw new Error('Token non disponibile');
    headers.Authorization = `Bearer ${token}`;
  }

  const response = await fetch(url, {
    ...options,
    headers
  });

  const payload = await response.json().catch(() => ({}));
  if (!response.ok) {
    throw new Error(payload.error || 'Errore di richiesta');
  }

  return payload;
}

async function loginOrRegister(event) {
  event.preventDefault();
  const formData = new FormData(authForm);
  const username = String(formData.get('username')).trim();
  const password = String(formData.get('password'));

  if (!username || !password) {
    showMessage('Inserisci username e password.', true);
    return;
  }

  try {
    const path = authMode === 'register' ? '/api/register' : '/api/login';
    const payload = await request(path, {
      method: 'POST',
      body: JSON.stringify({ username, password })
    }, false);

    setToken(payload.token);
    showMessage(authMode === 'register' ? 'Registrazione completata.' : 'Login effettuato.');
    await loadDashboard();
  } catch (error) {
    showMessage(error.message, true);
  }
}

async function loadDashboard() {
  try {
    const payload = await request('/api/dashboard');
    dashboardState = payload.dashboard;
    userLabel.textContent = `Utente: ${localStorage.getItem('smc-user-name') || 'Account'}`;
    renderDashboard();
    authScreen.classList.add('hidden');
    appShell.classList.remove('hidden');
  } catch (error) {
    clearToken();
    authScreen.classList.remove('hidden');
    appShell.classList.add('hidden');
    showMessage(error.message, true);
  }
}

function renderDashboard() {
  if (!dashboardState) return;

  const data = dashboardState;
  const summaryCards = [
    { label: 'Saldo', value: `€${Number(data.money?.saving || 0).toLocaleString('it-IT')}`, delta: `+€${Number(data.money?.gain || 0)}`, tone: 'green' },
    { label: 'Focus', value: `${Number(data.focus || 0)}%`, delta: '+8%', tone: 'blue' },
    { label: 'Allenamenti', value: '4/5', delta: '+1', tone: 'yellow' },
    { label: 'Sonno', value: data.sleep || '7h 20m', delta: '+35m', tone: 'green' }
  ];

  document.getElementById('summaryCards').innerHTML = summaryCards
    .map(
      (item) => `
        <article class="summary-card">
          <p class="label">${item.label}</p>
          <div class="value">
            <h3>${item.value}</h3>
            <span class="delta ${item.tone}">${item.delta}</span>
          </div>
        </article>
      `
    )
    .join('');

  document.getElementById('moneyGainTag').textContent = `+€${Number(data.money?.gain || 0)}`;
  document.getElementById('incomeValue').textContent = `€${Number(data.money?.income || 0).toLocaleString('it-IT')}`;
  document.getElementById('expenseValue').textContent = `€${Number(data.money?.expense || 0).toLocaleString('it-IT')}`;
  document.getElementById('savingValue').textContent = `€${Number(data.money?.saving || 0).toLocaleString('it-IT')}`;

  const incomePct = Math.min(((data.money?.income || 0) / 3500) * 100, 100);
  const expensePct = Math.min(((data.money?.expense || 0) / 3000) * 100, 100);
  const goalPct = Math.min(Number(data.money?.goal || 80), 100);

  document.getElementById('incomeBar').style.width = `${incomePct}%`;
  document.getElementById('expenseBar').style.width = `${expensePct}%`;
  document.getElementById('goalBar').style.width = `${goalPct}%`;

  document.getElementById('focusTag').textContent = `${Number(data.focus || 0)}/100`;
  document.getElementById('stepsTag').textContent = `${Number(data.steps || 0).toLocaleString('it-IT')} passi`;

  document.getElementById('mindList').innerHTML = (data.mind || [])
    .map(
      (item) => `
        <li>
          <div style="display:flex; align-items:center; gap:12px;">
            <span class="dot ${item.color}"></span>
            ${item.label}
          </div>
        </li>
      `
    )
    .join('');

  document.getElementById('bodyList').innerHTML = (data.body || [])
    .map(
      (item) => `
        <li>
          <div style="display:flex; align-items:center; gap:12px;">
            <span class="dot ${item.color}"></span>
            ${item.label}
          </div>
        </li>
      `
    )
    .join('');

  document.getElementById('priorityList').innerHTML = (data.priorities || [])
    .map(
      (item) => `
        <div class="priority-item">
          <div class="priority-main">
            <span class="priority-badge"></span>
            <div>
              <p>${item.title}</p>
              <small>${item.detail}</small>
            </div>
          </div>
          <span class="priority-value">${item.value}</span>
        </div>
      `
    )
    .join('');

  document.getElementById('trendChart').innerHTML = (data.trend || [48,58,64,72,81,76,90])
    .map(
      (value, index) => `
        <div class="chart-bar" style="height: ${value}%" data-label="${(data.labels || ['L','M','M','G','V','S','D'])[index]}"></div>
      `
    )
    .join('');

  document.getElementById('monthProgressValue').textContent = `${Number(data.monthProgress || 0)}%`;
  document.getElementById('monthProgressBar').style.width = `${Number(data.monthProgress || 0)}%`;
  document.getElementById('monthProgressText').textContent = '+12% rispetto al mese scorso';

  const budgetUsed = Math.min(((data.money?.expense || 0) / (data.money?.budget || 3300)) * 100, 100);
  const budgetDonut = document.getElementById('budgetDonut');
  budgetDonut.style.setProperty('--progress', Math.round(budgetUsed));
  document.getElementById('budgetDonutValue').textContent = `${Math.round(budgetUsed)}%`;
  document.getElementById('budgetContext').textContent = `€${Number(data.money?.expense || 0).toLocaleString('it-IT')} / €${Number(data.money?.budget || 3300).toLocaleString('it-IT')}`;

  const txList = document.getElementById('transactionList');
  txList.innerHTML = (data.money?.transactions || [])
    .slice(0, 6)
    .map(
      (entry) => `
        <li class="transaction-item ${entry.type === 'income' ? 'income' : 'expense'}">
          <div class="meta">
            <strong>${entry.category}</strong>
            <small>${entry.type === 'income' ? 'Entrata' : 'Spesa'}</small>
          </div>
          <span class="amount">${entry.type === 'income' ? '+' : '-'}€${Number(entry.amount || 0).toLocaleString('it-IT')}</span>
        </li>
      `
    )
    .join('');

  document.getElementById('mindScoreValue').textContent = `${Number(data.focus || 0)}%`;
  document.getElementById('mindScoreBar').style.width = `${Number(data.focus || 0)}%`;
  document.getElementById('dailyNote').value = data.dailyNote || '';
  document.getElementById('stepsDisplay').textContent = Number(data.steps || 0).toLocaleString('it-IT');
  document.getElementById('sleepDisplay').textContent = data.sleep || '7h 20m';

  document.getElementById('bodyActivities').innerHTML = [
    { label: 'Allenamento cardio', value: '45 min' },
    { label: 'Passeggiata mattutina', value: '30 min' },
    { label: 'Stretching serale', value: '10 min' }
  ].map(item => `
    <li class="habit-item">
      <span>${item.label}</span>
      <strong>${item.value}</strong>
    </li>
  `).join('');

  document.getElementById('mindRoutineList').innerHTML = [
    { label: 'Meditazione guidata', value: '15 min' },
    { label: 'Lettura approfondita', value: '20 min' },
    { label: 'Hobby creativo', value: '30 min' }
  ].map(item => `
    <li class="habit-item">
      <span>${item.label}</span>
      <strong>${item.value}</strong>
    </li>
  `).join('');

  document.getElementById('goalGrid').innerHTML = (data.goals || [])
    .map(
      (goal) => `
        <article class="goal-card">
          <div class="goal-card-header">
            <div style="display:flex; align-items:center; gap:10px;">
              <span class="goal-badge" style="background:${goal.color};"></span>
              <h4>${goal.name}</h4>
            </div>
            <span class="tag neutral">${goal.progress}%</span>
          </div>
          <div class="goal-progress">
            <span style="width:${goal.progress}%; background:${goal.color};"></span>
          </div>
          <div class="goal-meta">
            <span>${goal.amount}</span>
            <span>${goal.target}%</span>
          </div>
        </article>
      `
    )
    .join('');
}

async function updateDashboard(payload) {
  const data = await request('/api/dashboard', {
    method: 'POST',
    body: JSON.stringify(payload)
  });
  dashboardState = data.dashboard;
  renderDashboard();
}

async function addTransaction(event) {
  event.preventDefault();
  const form = event.target;
  const formData = new FormData(form);
  const type = formData.get('type');
  const category = String(formData.get('category') || '').trim();
  const amount = Number(formData.get('amount'));

  if (!category || !amount || amount <= 0) return;

  const data = await request('/api/transactions', {
    method: 'POST',
    body: JSON.stringify({ type, category, amount })
  });

  dashboardState = data.dashboard;
  renderDashboard();
  form.reset();
}

async function refreshData() {
  const randomData = {
    monthProgress: 68 + Math.floor(Math.random() * 22),
    focus: 78 + Math.floor(Math.random() * 18),
    steps: 7200 + Math.floor(Math.random() * 2800),
    sleep: `${6 + Math.floor(Math.random() * 2)}h ${Math.floor(Math.random() * 60)}`.replace('h 0', 'h 00'),
    trend: Array.from({ length: 7 }, () => 35 + Math.floor(Math.random() * 55)),
    goals: (dashboardState?.goals || []).map((goal) => ({
      ...goal,
      progress: Math.min(100, Math.max(35, goal.progress + (Math.random() > 0.5 ? 8 : -6)))
    }))
  };

  await updateDashboard(randomData);
}

async function logout() {
  clearToken();
  authScreen.classList.remove('hidden');
  appShell.classList.add('hidden');
  showMessage('Logout effettuato.');
}

function initEvents() {
  authForm.addEventListener('submit', loginOrRegister);
  document.querySelectorAll('.mode-btn').forEach((btn) => {
    btn.addEventListener('click', () => setAuthMode(btn.dataset.mode));
  });

  document.querySelectorAll('.nav-item').forEach((button) => {
    button.addEventListener('click', () => {
      document.querySelectorAll('.nav-item').forEach((btn) => btn.classList.remove('active'));
      button.classList.add('active');
      const view = button.dataset.view;
      document.querySelectorAll('.view').forEach((section) => {
        section.classList.toggle('active', section.id === view);
      });
    });
  });

  document.getElementById('transactionForm').addEventListener('submit', addTransaction);
  document.getElementById('refreshDataBtn').addEventListener('click', refreshData);
  document.getElementById('logoutBtn').addEventListener('click', logout);
  document.getElementById('dailyNote').addEventListener('input', async (event) => {
    const value = event.target.value;
    await updateDashboard({ dailyNote: value });
  });
}

async function bootstrap() {
  initEvents();
  setAuthMode('login');

  const token = getToken();
  if (token) {
    try {
      const payload = await request('/api/me');
      localStorage.setItem('smc-user-name', payload.user.username);
      userLabel.textContent = `Utente: ${payload.user.username}`;
      await loadDashboard();
    } catch {
      clearToken();
      authScreen.classList.remove('hidden');
      appShell.classList.add('hidden');
    }
  } else {
    authScreen.classList.remove('hidden');
    appShell.classList.add('hidden');
  }
}

bootstrap();

















































































































































































































